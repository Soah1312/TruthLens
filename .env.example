# TruthLens Environment Configuration Example
PROJECT_NAME="TruthLens"
VERSION="1.0.0"
ENVIRONMENT="development"
HOST="127.0.0.1"
PORT=8000

# Database Configuration (SQLite for local development)
DATABASE_URL="sqlite:///./truthlens.db"

# CORS Configuration
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# NLP Model Inference Settings (DeBERTa-v3 + Metadata)
MODEL_SOURCE="huggingface"
HF_MODEL_REPO="soah-13/truthlens-deberta-v3-liar"
HF_TOKEN="your_huggingface_token_here"
LOCAL_MODEL_PATH="models/deberta-v3-liar"
METRICS_FILE_PATH="models/deberta-v3-liar/evaluation_results.json"

# External Evidence Retrieval (Phase 3B - Tavily Search API)
TAVILY_API_KEY="your_tavily_api_key_here"
TAVILY_SEARCH_DEPTH="basic"
TAVILY_MAX_RESULTS=5

# Groq LLM Evidence Analysis Configuration
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2
GROQ_MAX_SOURCES=5

# Telegram Bot Integration (Phase 3C & Webhook Migration)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_WEBHOOK_SECRET="your_custom_secret_token_here"
TELEGRAM_WEBHOOK_URL="https://your-backend-service.onrender.com/api/telegram/webhook"
API_BASE_URL="http://127.0.0.1:8000"
