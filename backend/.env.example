# TruthLens Backend Environment Configuration
PROJECT_NAME="TruthLens"
VERSION="1.0.0"
ENVIRONMENT="development"
HOST="127.0.0.1"
PORT=8000

# Database Configuration (SQLite for local development)
DATABASE_URL="sqlite:///./truthlens.db"

# CORS Configuration
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Phase 2: NLP Model Inference Settings
# Set MODEL_SOURCE to 'local' (extract Colab zip into models/distilbert-liar)
# or 'huggingface' (download directly from your Hugging Face Hub repository)
MODEL_SOURCE="local"
LOCAL_MODEL_PATH="models/distilbert-liar"
HF_MODEL_REPO="your-username/truthlens-distilbert-liar"
METRICS_FILE_PATH="models/distilbert-liar/metrics.json"
