# TruthLens Backend Environment Configuration
PROJECT_NAME="TruthLens"
VERSION="1.0.0"
ENVIRONMENT="development"
HOST="127.0.0.1"
PORT=8000

# Database Configuration (SQLite for local development)
DATABASE_URL="sqlite:///./truthlens.db"

# CORS Configuration
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# NLP Model Inference Settings (RoBERTa + Metadata)
# Set MODEL_SOURCE to 'huggingface' (download directly from your Hugging Face Hub repository)
# or 'local' (extract Colab zip into models/roberta-liar-meta)
MODEL_SOURCE="huggingface"
HF_MODEL_REPO="soah-13/truthlens-roberta-liar-meta"
HF_TOKEN="your_huggingface_token_here"
LOCAL_MODEL_PATH="models/roberta-liar-meta"
METRICS_FILE_PATH="models/roberta-liar-meta/metrics.json"
